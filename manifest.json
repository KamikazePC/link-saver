{
  "manifest_version": 3,
  "name": "Link Saver",
  "version": "1.0.0",
  "description": "Save the page you're on to read later, with an optional note and tags. Everything stays on your computer.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Save this page (Alt+Shift+S)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open the save popup for this page"
    },
    "quick-save": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Save this page right away, without a note or tags"
    }
  }
}
